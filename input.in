[system]
numParticles = 2
T = 1, 5, 10 , 30, 50
lam = 0.5, 0.5
n = 1

[PIMC]
numMCSteps = 100000
numTimeSlices = 32
m = 8  
delta = 1.0
delta_bead = 0.05
use_jit = True
staging = True         
echange = False
non_adiabatic_coupling = False   
PoE = False
kin_virial = True
rand_seed = 153

[convergence]
thermSkip = 1000  
corrSkip = 20     
eCG = 1
eCL = 1 

[debug]
logging = False

[maxent]
k = 1, 20
block_size = 10
n_w = 500
wmax_abs = 10
method = maxent_svd
alpha_determination = bryan
optimizer = newton
kernel_mode = time_bosonic